<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.INTERNET" />

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.MyApplication"
        tools:targetApi="31">

        <activity android:name=".main.MainActivity" android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity android:name=".tools.daily.TomatoClockActivity" android:exported="true" />
        <activity android:name=".tools.daily.CountdownActivity" android:exported="true" />
        <activity android:name=".tools.daily.RandomNumberActivity" android:exported="true" />
        <activity android:name=".tools.daily.UnitConverterActivity" android:exported="true" />
        <activity android:name=".tools.daily.TranslateActivity" android:exported="true" />
        <activity android:name=".tools.measure.RulerActivity" android:exported="true" />
        <activity android:name=".tools.measure.CompassActivity" android:exported="true" />
        <activity android:name=".tools.measure.SpiritLevelActivity" android:exported="true" />
        <activity android:name=".tools.measure.NoiseActivity" android:exported="true" />
        <activity android:name=".tools.image.QRCodeActivity" android:exported="true" />
        <activity android:name=".tools.image.QRCodeScanActivity" android:exported="true" />
        <activity android:name=".tools.image.ColorPickerActivity" android:exported="true" />
        <activity android:name=".tools.reference.ChineseColorsActivity" android:exported="true" />
        <activity android:name=".tools.reference.LinuxCommandActivity" android:exported="true" />
        <activity android:name=".tools.reference.TodayInHistoryActivity" android:exported="true" />

    </application>
</manifest>
