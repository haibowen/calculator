<?xml version="1.0" encoding="utf-8"?>
<animated-selector
  xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto">
    <item android:state_enabled="true" android:id="@id/part_normal" android:drawable="@drawable/calculator_btn_part_check_on_normal" app:calculator_state_allSelect="false" app:calculator_state_partSelect="true" />
    <item android:state_enabled="false" android:id="@id/part_normal_disabled" android:drawable="@drawable/calculator_btn_part_check_on_disabled" app:calculator_state_allSelect="false" app:calculator_state_partSelect="true" />
    <item android:state_enabled="true" android:id="@id/selected_normal" android:drawable="@drawable/calculator_btn_check_on_normal" app:calculator_state_allSelect="true" app:calculator_state_partSelect="false" />
    <item android:state_enabled="false" android:id="@id/selected_normal_disabled" android:drawable="@drawable/calculator_btn_check_on_disabled" app:calculator_state_allSelect="true" app:calculator_state_partSelect="false" />
    <item android:state_enabled="true" android:id="@id/unselected_normal" android:drawable="@drawable/calculator_btn_check_off_normal" app:calculator_state_allSelect="false" app:calculator_state_partSelect="false" />
    <item android:state_enabled="false" android:drawable="@drawable/calculator_btn_check_off_disabled" app:calculator_state_allSelect="false" app:calculator_state_partSelect="false" />
    <transition android:drawable="@drawable/calculator_checkbox_selected_to_unselected" android:toId="@id/unselected_normal" android:fromId="@id/selected_normal" />
    <transition android:drawable="@drawable/calculator_checkbox_unselected_to_selected" android:toId="@id/selected_normal" android:fromId="@id/unselected_normal" />
    <transition android:drawable="@drawable/calculator_checkbox_part_to_unselected" android:toId="@id/unselected_normal" android:fromId="@id/part_normal" />
    <transition android:drawable="@drawable/calculator_checkbox_unselected_to_part" android:toId="@id/part_normal" android:fromId="@id/unselected_normal" />
    <transition android:drawable="@drawable/calculator_checkbox_part_to_selected" android:toId="@id/selected_normal" android:fromId="@id/part_normal" />
    <transition android:drawable="@drawable/calculator_checkbox_selected_to_part" android:toId="@id/part_normal" android:fromId="@id/selected_normal" />
    <transition android:drawable="@drawable/calculator_checkbox_part_to_selected_for_disabled" android:toId="@id/selected_normal_disabled" android:fromId="@id/part_normal_disabled" />
    <transition android:drawable="@drawable/calculator_checkbox_selected_to_part_for_disabled" android:toId="@id/part_normal_disabled" android:fromId="@id/selected_normal_disabled" />
</animated-selector>
